<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MadiumManager</AssemblyName>
    <RootNamespace>MadiumManager.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\MadiumManager.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Branding\MadiumManagerLogo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MadiumManager.Application\MadiumManager.Application.csproj" />
    <ProjectReference Include="..\MadiumManager.Domain\MadiumManager.Domain.csproj" />
    <ProjectReference Include="..\MadiumManager.Infrastructure\MadiumManager.Infrastructure.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
