<Window x:Class="MadiumManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MadiumManager.Desktop.Models"
        xmlns:views="clr-namespace:MadiumManager.Desktop.Views"
        Title="Madium Manager"
        Icon="pack://application:,,,/Assets/Branding/MadiumManagerLogo.png"
        Width="1320"
        Height="820"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Background="{StaticResource SidebarBrush}">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,6,4,30">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Width="42"
                 Height="42"
                 Source="pack://application:,,,/Assets/Branding/MadiumManagerLogo.png"
                 Stretch="Uniform" />
          <StackPanel Grid.Column="1" Margin="6,3,0,0">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Madium Manager" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="Панель управления" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="{x:Static models:AppPage.Dashboard}"
                  Background="{Binding CurrentPage, Converter={StaticResource AppPageToBrush}, ConverterParameter=Dashboard}"
                  Content="▦   Обзор"
                  Style="{StaticResource NavButton}" />
          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="{x:Static models:AppPage.Accounts}"
                  Background="{Binding CurrentPage, Converter={StaticResource AppPageToBrush}, ConverterParameter=Accounts}"
                  Content="◎   Аккаунты"
                  Style="{StaticResource NavButton}" />
          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="{x:Static models:AppPage.Events}"
                  Background="{Binding CurrentPage, Converter={StaticResource AppPageToBrush}, ConverterParameter=Events}"
                  Content="≡   Журнал событий"
                  Style="{StaticResource NavButton}" />
          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="{x:Static models:AppPage.Settings}"
                  Background="{Binding CurrentPage, Converter={StaticResource AppPageToBrush}, ConverterParameter=Settings}"
                  Content="⚙   Настройки"
                  Style="{StaticResource NavButton}" />
        </StackPanel>

        <Border Grid.Row="3"
                Padding="12"
                Background="#FFF7E6"
                CornerRadius="8">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="#A15C00" />
              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#A15C00" Text="ДЕМО-RUNTIME" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource MutedText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="Действия интерфейса доступны без запуска процессов ОС." />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="34" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="26,22,26,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="27" FontWeight="SemiBold" Text="{Binding CurrentPageTitle}" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Text="{Binding CurrentPageSubtitle}" />
          </StackPanel>
          <Button Grid.Column="1"
                  VerticalAlignment="Center"
                  Padding="16,10"
                  Command="{Binding StartNextCommand}"
                  Content="▶  Запустить следующий"
                  Style="{StaticResource PrimaryButton}" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="26,0,26,20">
        <views:DashboardView Visibility="{Binding CurrentPage, Converter={StaticResource AppPageToVisibility}, ConverterParameter=Dashboard}" />
        <views:AccountsView Visibility="{Binding CurrentPage, Converter={StaticResource AppPageToVisibility}, ConverterParameter=Accounts}" />
        <views:EventsView Visibility="{Binding CurrentPage, Converter={StaticResource AppPageToVisibility}, ConverterParameter=Events}" />
        <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource AppPageToVisibility}, ConverterParameter=Settings}" />
      </Grid>

      <Border Grid.Row="2"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Background="#FFFFFF">
        <Grid Margin="26,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     Style="{StaticResource MutedText}"
                     FontSize="11"
                     Text="{Binding LastOperation}" />
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Style="{StaticResource MutedText}"
                     FontSize="11"
                     Text="Локальные данные · %LocalAppData%\MadiumManager" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
