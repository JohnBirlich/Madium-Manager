<Window x:Class="MadiumManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Madium Manager"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="32">
    <StackPanel>
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="Madium Manager" />
      <TextBlock Margin="0,12,0,0"
                 Foreground="#555555"
                 TextWrapping="Wrap"
                 Text="Windows shell for the account coordinator and Medium-only process watchdog. Bind this view to MVVM view models; do not put process or network logic in code-behind." />
    </StackPanel>
  </Grid>
</Window>
