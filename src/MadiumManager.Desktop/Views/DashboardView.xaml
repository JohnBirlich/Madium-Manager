<UserControl x:Class="MadiumManager.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <UniformGrid Columns="4">
        <Border Margin="0,0,12,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource MutedText}" Text="ВСЕГО АККАУНТОВ" />
            <TextBlock Margin="0,10,0,0" FontSize="29" FontWeight="SemiBold" Text="{Binding TotalAccounts}" />
            <TextBlock Margin="0,5,0,0" Style="{StaticResource MutedText}" FontSize="11" Text="локальный пул" />
          </StackPanel>
        </Border>
        <Border Margin="0,0,12,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource MutedText}" Text="АКТИВНЫЕ" />
            <TextBlock Margin="0,10,0,0" FontSize="29" FontWeight="SemiBold" Foreground="#087F5B" Text="{Binding ActiveAccounts}" />
            <TextBlock Margin="0,5,0,0" Style="{StaticResource MutedText}" FontSize="11" Text="прошли проверку" />
          </StackPanel>
        </Border>
        <Border Margin="0,0,12,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource MutedText}" Text="СЕССИИ" />
            <TextBlock Margin="0,10,0,0" FontSize="29" FontWeight="SemiBold" Foreground="#4F46E5" Text="{Binding RunningAccounts}" />
            <TextBlock Margin="0,5,0,0" Style="{StaticResource MutedText}" FontSize="11" Text="работают сейчас" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource MutedText}" Text="ТРЕБУЮТ ВНИМАНИЯ" />
            <TextBlock Margin="0,10,0,0" FontSize="29" FontWeight="SemiBold" Foreground="#C4324B" Text="{Binding IssueAccounts}" />
            <TextBlock Margin="0,5,0,0" Style="{StaticResource MutedText}" FontSize="11" Text="бан или ошибка" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,16,0" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource CardTitleText}" Text="Рабочие сессии" />
              <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Text="Live · 1 сек" />
            </Grid>

            <Grid Grid.Row="1">
              <ScrollViewer MaxHeight="405" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SessionsView}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,10"
                              Padding="14"
                              Background="{StaticResource CardAltBrush}"
                              CornerRadius="9">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Text="{Binding ServerDisplay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="16,0" HorizontalAlignment="Center">
                            <Border Padding="9,4" Background="{Binding SessionBackground}" CornerRadius="6">
                              <TextBlock FontSize="11" Foreground="{Binding SessionForeground}" Text="{Binding SessionText}" />
                            </Border>
                            <TextBlock Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Text="{Binding UptimeDisplay}" />
                          </StackPanel>
                          <Button Grid.Column="2"
                                  Margin="6,0,0,0"
                                  Padding="10,7"
                                  VerticalAlignment="Center"
                                  Command="{Binding DataContext.SimulateCrashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  Content="↻"
                                  IsEnabled="{Binding CanSimulateCrash}"
                                  ToolTip="Тест reconnect через Medium" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{Binding HasSessions, Converter={StaticResource InverseBooleanToVisibility}}">
                <TextBlock HorizontalAlignment="Center" FontSize="32" Foreground="#94A3B8" Text="◎" />
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource MutedText}"
                           Text="Активных сессий пока нет" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource MutedText}"
                           FontSize="11"
                           Text="Запустите следующий аккаунт, чтобы увидеть live-статус." />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitleText}" Text="Быстрые действия" />
              <Button Margin="0,16,0,0"
                      Command="{Binding StartNextCommand}"
                      Content="▶  Запустить следующий"
                      Style="{StaticResource PrimaryButton}" />
              <Button Margin="0,9,0,0"
                      Command="{Binding SimulateCrashCommand}"
                      CommandParameter="{Binding SelectedAccount}"
                      Content="↻  Тест reconnect выбранного"
                      IsEnabled="{Binding SelectedAccount.CanSimulateCrash, TargetNullValue=False, FallbackValue=False}" />
              <Button Margin="0,9,0,0"
                      Command="{Binding StopAllCommand}"
                      Content="■  Остановить все сессии" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource CardTitleText}" Text="Последние события" />
              <ScrollViewer Grid.Row="1" Margin="0,13,0,0" MaxHeight="248" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding EventsView}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="{Binding TimeText}" />
                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding Message}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
