<UserControl x:Class="MadiumManager.Desktop.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0"
               VerticalContentAlignment="Center"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Поиск по имени, логину или серверу" />
      <TextBlock Margin="14,0,0,0"
                 VerticalAlignment="Center"
                 Style="{StaticResource MutedText}"
                 Text="Поиск по имени, логину или серверу" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Margin="0,0,9,0" Command="{Binding CheckAllCommand}" Content="✓  Проверить все" />
        <Button Command="{Binding AddAccountCommand}" Content="＋  Добавить аккаунт" Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Padding="0" Style="{StaticResource Card}">
      <Grid>
        <DataGrid ItemsSource="{Binding AccountsView}"
                  SelectedItem="{Binding SelectedAccount}"
                  AutoGenerateColumns="False"
                  AlternationCount="2"
                  VerticalScrollBarVisibility="Auto">
          <DataGrid.AlternatingRowBackground>
            <SolidColorBrush Color="#FAFBFC" />
          </DataGrid.AlternatingRowBackground>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="АККАУНТ" Width="2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" FontSize="11" Text="{Binding Login}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="SERVER-SIDE" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border HorizontalAlignment="Left"
                          Padding="9,5"
                          Background="{Binding HealthBackground}"
                          CornerRadius="6">
                    <TextBlock FontSize="11" Foreground="{Binding HealthForeground}" Text="{Binding HealthText}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="MEDIUM" Width="145">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border HorizontalAlignment="Left"
                          Padding="9,5"
                          Background="{Binding SessionBackground}"
                          CornerRadius="6">
                    <TextBlock FontSize="11" Foreground="{Binding SessionForeground}" Text="{Binding SessionText}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="СЕРВЕР" Width="175" Binding="{Binding ServerDisplay}" />
            <DataGridTextColumn Header="UPTIME" Width="95" Binding="{Binding UptimeDisplay}" />
            <DataGridTextColumn Header="ПОСЛЕДНЯЯ ПРОВЕРКА" Width="185" Binding="{Binding LastCheckedDisplay}" />

            <DataGridTemplateColumn Header="ДЕЙСТВИЯ" Width="300">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="2,0"
                            Padding="9,6"
                            Command="{Binding DataContext.StartAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="▶"
                            IsEnabled="{Binding CanStart}"
                            ToolTip="Запустить через Medium" />
                    <Button Margin="2,0"
                            Padding="9,6"
                            Command="{Binding DataContext.StopAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="■"
                            IsEnabled="{Binding CanStop}"
                            ToolTip="Остановить" />
                    <Button Margin="2,0"
                            Padding="9,6"
                            Command="{Binding DataContext.SimulateCrashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="↻"
                            IsEnabled="{Binding CanSimulateCrash}"
                            ToolTip="Тест падения и reconnect к тому же серверу" />
                    <Button Margin="2,0"
                            Padding="9,6"
                            Command="{Binding DataContext.CheckAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="✓"
                            ToolTip="Проверить server-side статус" />
                    <Button Margin="2,0"
                            Padding="9,6"
                            Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="✎"
                            ToolTip="Изменить" />
                    <Button Margin="2,0"
                            Padding="9,6"
                            Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="×"
                            Style="{StaticResource DangerButton}"
                            ToolTip="Удалить" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasAccounts, Converter={StaticResource InverseBooleanToVisibility}}">
          <TextBlock HorizontalAlignment="Center" FontSize="36" Foreground="#94A3B8" Text="◎" />
          <TextBlock Margin="0,12,0,0" FontSize="18" Text="Пул аккаунтов пуст" />
          <Button Margin="0,16,0,0"
                  HorizontalAlignment="Center"
                  Command="{Binding AddAccountCommand}"
                  Content="＋  Добавить первый аккаунт"
                  Style="{StaticResource PrimaryButton}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Margin="0,16,0,0"
            Padding="16"
            DataContext="{Binding SelectedAccount}"
            Style="{StaticResource Card}"
            Visibility="{Binding HasAccounts, Converter={StaticResource BooleanToVisibility}, RelativeSource={RelativeSource AncestorType=UserControl}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="ВЫБРАННЫЙ АККАУНТ" />
          <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding DisplayName}" />
          <TextBlock Margin="0,5,0,0"
                     Style="{StaticResource MutedText}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="{Binding Note}" />
          <TextBlock Margin="0,7,0,0"
                     Foreground="#C4324B"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Visibility="{Binding LastError, Converter={StaticResource NonEmptyStringToVisibility}}"
                     Text="{Binding LastError}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal">
          <Button Margin="0,0,8,0"
                  Command="{Binding DataContext.CheckAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"
                  Content="✓  Проверить" />
          <Button Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"
                  Content="✎  Изменить" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
